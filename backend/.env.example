# SmartAssist Backend Configuration

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Database ---
# Options: firebase, mongodb
DB_PROVIDER=firebase
MONGODB_URI=
# Optional for direct Node.js runs. Docker Compose supplies this path automatically.
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- AI ---
# Options: gemini, openai, groq
AI_PROVIDER=gemini
AI_TIMEOUT_MS=8000
AI_MAX_RETRIES=2

# Gemini
# Gemini is the primary provider when AI_PROVIDER=gemini. If it fails, the
# backend automatically tries Groq, then OpenAI, before using the keyword fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
